# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase Backend Configuration (Auth, Database, Storage, Functions)
# Get these from your Supabase Project Settings -> API (https://supabase.com/dashboard)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Agora WebRTC Configuration (Audio/Video Calling & Live Streaming)
# Get these from Agora Console (https://console.agora.io/)
AGORA_APP_ID="your-agora-app-id"
AGORA_TOKEN=""


