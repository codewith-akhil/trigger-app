# ============================================================================
# Trigger App — Supabase Edge Function SECRETS template
# ----------------------------------------------------------------------------
# Copy to `supabase/.env` and fill in real values, then push with:
#   supabase secrets set --env-file supabase/.env
#
# The `supabase/.env` file is gitignored — NEVER commit real secrets.
# Every key here is read server-side via Deno.env.get(...) in edge functions.
# ============================================================================

# ---- Supabase (the project itself) -----------------------------------------
SUPABASE_URL=https://uazkcainrajcgxecomly.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVhemtjYWlucmFqY2d4ZWNvbWx5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg0NTkwMTksImV4cCI6MjEwNDAzNTAxOX0.laoOt2R3T4pdX3J_hp4_yABoeQNxrvlnt6lNDhnkh1o
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVhemtjYWlucmFqY2d4ZWNvbWx5Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODQ1OTAxOSwiZXhwIjoyMTA0MDM1MDE5fQ.YO0oNMnyyt5n3KATm3i0yQPkCPI2guehp6QwMbc-Vto

# ---- Agora RTC (audio/video calls + live streaming) ------------------------
# App ID is safe to expose to the client; the Primary Certificate is the
# server-only signing key for AccessToken2 and MUST NEVER be shipped to Android.
AGORA_APP_ID=b17004d7060b4ee0bf6e50cb931e1bbd
AGORA_PRIMARY_CERTIFICATE=1695667e407d4900bd13c5333df86934

# ---- Resend (transactional email / OTP / stream confirmations) -------------
# Create a key at https://resend.com/api-keys  (start with a test key).
# Verify your sending domain first (e.g. triggerapp.com) — see SETUP_NOTES.md.
RESEND_API_KEY=re_test_00000000000000000000000000000000
FROM_EMAIL=Trigger App <no-reply@triggerapp.com>
REPLY_TO_EMAIL=support@triggerapp.com

# ---- Firebase Cloud Messaging (push notifications) -------------------------
# Download the service-account JSON from Firebase Console → Project settings →
# Service accounts → Generate new private key. Put the THREE fields below as
# env vars (do NOT paste the whole JSON). See SETUP_NOTES.md.
FIREBASE_PROJECT_ID=trigger-app-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@trigger-app-xxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Razorpay (paid stream bookings + wallet top-ups) ----------------------
# Test keys from https://dashboard.razorpay.com/app/keys  (rzp_test_...)
# Replace with live keys when going to production.
RAZORPAY_KEY_ID=rzp_test_00000000000000
RAZORPAY_KEY_SECRET=00000000000000000000000000
RAZORPAY_WEBHOOK_SECRET=00000000000000000000000000
